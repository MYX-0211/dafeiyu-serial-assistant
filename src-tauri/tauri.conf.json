{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "大肥鱼串口助手",
  "version": "2.1.0",
  "identifier": "com.myx.dafeiyu-serial-assistant",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "大肥鱼串口助手",
        "width": 1020,
        "height": 680,
        "minWidth": 840,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#EEF2F9"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "shortDescription": "串口 / TCP / UDP 调试工具",
    "longDescription": "大肥鱼串口助手 — 串口 / TCP / UDP 调试工具，白色毛玻璃界面，中英双语"
  }
}
